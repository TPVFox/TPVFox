<?xml version="1.0" encoding="utf-8"?>
<parametros>
	<configuracion>
		<posstock>
			<ventana_dias>7</ventana_dias>
			<!-- Umbral sobrestock expresado en porcentaje (ej: 50 = 50%). Rango 0-200 -->
			<umbral_sobrestock>50</umbral_sobrestock>
			<!-- Umbral: semanas desde la última venta usado para detección de caducidad teórica -->
			<umbral_semanas_desde_ultima_venta>24</umbral_semanas_desde_ultima_venta>
			<!-- Umbral: semanas desde la última salida/venta usado para detectar entrada sin rotación -->
			<umbral_semanas_sin_rotacion>12</umbral_semanas_sin_rotacion>
			<!-- 1 = incluir artículos con stock positivo y cero movimientos en el periodo analizado -->
			<incluir_stock_inactivo>0</incluir_stock_inactivo>
			<!-- C6 — días de lead time por defecto cuando no hay pedidos históricos suficientes -->
			<c6_lead_time_defecto>14</c6_lead_time_defecto>
			<!-- Modelo estadístico para C5 y C6: automatico | binomial | poisson_bn | gamma -->
			<modelo_estadistico>automatico</modelo_estadistico>
			<!-- Significancia / nivel de servicio (C5: umbral de gap; C6: nivel ROP): 0.90 | 0.95 | 0.99 -->
			<modelo_significancia>0.95</modelo_significancia>
			<!-- Multiplicador σ para modo Binomial (C5: umbral=μ+nσ; C6: SS=nσ·σ_d·√L). Rango 2.0–4.0 -->
			<binomial_sigma_mult>3.0</binomial_sigma_mult>
			<!-- 1 = incluir en C5 artículos con stock negativo al cierre (roturas recuperadas solo; KO requiere stock > 0) -->
			<c5_incluir_stock_negativo>0</c5_incluir_stock_negativo>
			<!-- 1 = incluir albaranes de cliente como ventas en C5 y C6 (por defecto solo tickets de caja) -->
			<incluir_albcli_ventas>0</incluir_albcli_ventas>
			<!-- Último rango consultado: preselecciona los selectores al abrir el informe -->
			<tipo_periodo></tipo_periodo>
			<numero_periodo></numero_periodo>
			<anio_periodo></anio_periodo>
		</posstock>
	</configuracion>
</parametros>
