<?xml version="1.0" encoding="utf-8"?>
<parametros>
	<configuracion>
		<posstock>
			<ventana_dias>7</ventana_dias>
			<!-- Umbral sobrestock expresado en porcentaje (ej: 50 = 50%). Rango 0-100 -->
			<umbral_sobrestock>50</umbral_sobrestock>
			<!-- C2: días de cobertura mínimos (stock_previo / ventas_diarias_periodo) para que la recepción
			     se considere problemática. Si la cobertura es menor, se asume que la rotación justifica el stock.
			     Ej: 21 = solo flagear si el stock previo cubre más de 21 días de ventas -->
			<c2_umbral_cobertura_dias>21</c2_umbral_cobertura_dias>
			<!-- Umbral: semanas desde la última venta usado para detección de caducidad teórica -->
			<umbral_semanas_desde_ultima_venta>24</umbral_semanas_desde_ultima_venta>
			<!-- Umbral: semanas desde la última salida/venta usado para detectar entrada sin rotación -->
			<umbral_semanas_sin_rotacion>12</umbral_semanas_sin_rotacion>
			<!-- 1 = incluir artículos con stock positivo y cero movimientos en el periodo analizado -->
			<incluir_stock_inactivo>0</incluir_stock_inactivo>
			<!-- C6 — días de lead time por defecto cuando no hay pedidos históricos suficientes -->
			<c6_lead_time_defecto>14</c6_lead_time_defecto>
			<!-- C6b — ventana de demanda activa (días hacia atrás desde hoy) para el ROP operacional.
			     C6a usa el periodo analizado ±1; C6b siempre mide los últimos N días desde hoy
			     para evitar falsas alarmas en productos de temporada fuera de su época. -->
			<c6b_dias_historico>90</c6b_dias_historico>
			<!-- Modelo estadístico para C5 y C6: automatico | binomial | poisson_bn | gamma -->
			<modelo_estadistico>automatico</modelo_estadistico>
			<!-- Significancia / nivel de servicio (C5: umbral de gap; C6: nivel ROP): 0.90 | 0.95 | 0.99 -->
			<modelo_significancia>0.95</modelo_significancia>
			<!-- Multiplicador σ para modo Binomial (C5: umbral=μ+nσ; C6: SS=nσ·σ_d·√L). Rango 2.0–4.0 -->
			<binomial_sigma_mult>3.0</binomial_sigma_mult>
			<!-- 1 = incluir en C5 artículos con stock negativo al cierre (roturas recuperadas solo; KO requiere stock > 0) -->
			<c5_incluir_stock_negativo>0</c5_incluir_stock_negativo>
			<!-- 1 = incluir albaranes de cliente como ventas en C5 y C6 (por defecto solo tickets de caja) -->
			<incluir_albcli_ventas>0</incluir_albcli_ventas>
			<!-- C3b — días posteriores al rango analizado para validar que un artículo "nunca vendido"
			     no es un falso positivo (entró al final del periodo y aún no había tenido tiempo de vender) -->
			<c3b_dias_post_periodo>14</c3b_dias_post_periodo>
			<!-- C3a — multiplicador sobre la cadencia media histórica del artículo para calcular
			     el umbral dinámico de rotación: umbral_dias = avg_cadencia_dias × multiplicador.
			     Ejemplo: artículo que vende cada 3 días → alerta con 3×3=9 días sin venta.
			     Rango recomendado: 2.0–6.0 -->
			<c3a_multiplicador_cadencia>3.0</c3a_multiplicador_cadencia>
			<!-- Umbral de reconstrucción de stock: si stock > N�ROP se recalcula desde la última entrada de compra menos ventas. Mínimo: 3.0 -->
			<umbral_reconstituir_rop>10</umbral_reconstituir_rop>
			<!-- Umbral de stock negativo para reconstrucción: si stock < -N se recalcula desde la última entrada. Valor positivo (ej: 2 = reconstruir si stock < -2). -->
			<umbral_stock_negativo>2</umbral_stock_negativo>
			<!-- C1 — Umbral decimal básico: parte fraccionaria mínima para considerar un stock con decimales sospechosos (0.05 = 50g en balanza). -->
			<c1_umbral_fraccionado>0.05</c1_umbral_fraccionado>
			<!-- C1 — Umbral de magnitud: cierre/mínimo máximo (kg/ud) para considerar que el negativo puede ser drift de balanza. -->
			<c1_umbral_magnitud>0.5</c1_umbral_magnitud>
			<!-- C1 — Umbral por venta: margen de error por operación de pesaje (kg/ud). Se multiplica por n_ventas para el umbral dinámico. -->
			<c1_umbral_por_venta>0.010</c1_umbral_por_venta>
			<!-- C1b — Ventana de timing: días máximos tras el mínimo para considerar que una recepción explica el negativo puntual. -->
			<c1_timing_ventana_dias>1</c1_timing_ventana_dias>
			<!-- C7b — Mínimo de recepciones históricas (período base) para que el test IC95 sea válido. Rango: 3–10 -->
			<c7b_min_recepciones>3</c7b_min_recepciones>
			<!-- C7b — Umbral máximo de CV (coeficiente de variación) para considerar el patrón estable. Artículos por unidad. Rango: 0.3–0.9 -->
			<c7b_umbral_cv>0.5</c7b_umbral_cv>
			<!-- C7b — Umbral máximo de CV para artículos de peso. Mayor porque la variabilidad de pesaje y cantidad por entrega es intrínseca. Rango: 0.5–1.2 -->
			<c7b_umbral_cv_peso>0.75</c7b_umbral_cv_peso>
			<!-- C7b — Multiplicador IQR para artículos de peso (IQR < N × |media|). Mayor que el 1.5 de unidad. Rango: 1.5–3.0 -->
			<c7b_umbral_iqr_peso>2.0</c7b_umbral_iqr_peso>
			<!-- C7b — Umbral de ruido de pesaje: déficit medio (kg) por debajo del cual se emite C7b_ruido_peso en vez de C7b. Solo afecta a artículos de tipo peso. Rango: 0.1–2.0 -->
			<c7b_umbral_ruido_peso>0.5</c7b_umbral_ruido_peso>
			<!-- C7b — Déficit medio mínimo (ud.) para severidad ALTA en artículos de tipo unidad. Rango: 2–20 -->
			<c7b_umbral_severidad_unidad>5</c7b_umbral_severidad_unidad>
			<!-- C7b — Déficit medio mínimo (kg) para severidad ALTA en artículos de tipo peso. Rango: 0.5–10.0 -->
			<c7b_umbral_severidad_peso>2.5</c7b_umbral_severidad_peso>
			<!-- C7b — Cascada exhaustiva: si true, continúa la cascada estadística aunque un test sea válido pero no significativo (diagnóstico). Por defecto: false -->
			<c7b_cascada_exhaustiva>false</c7b_cascada_exhaustiva>
			<!-- C7a — Variación acumulada mínima (delta_total = floor_último - floor_primero) para que el artículo entre en el análisis de tendencia. Artículos de unidad vs peso. -->
			<c7a_umbral_delta_unidad>2.0</c7a_umbral_delta_unidad>
			<c7a_umbral_delta_peso>1.0</c7a_umbral_delta_peso>
			<!-- C7a — Umbral p-value Mann-Kendall para resultado negativo (p ≥ umbral → NO C7a). Rango recomendado: 0.05–0.20 -->
			<c7a_umbral_pvalue>0.10</c7a_umbral_pvalue>
			<!-- C7a — Umbral p-value Mann-Kendall para confianza 'alta' (p < umbral_alta → C7a confirmado nivel 1). Debe ser menor que c7a_umbral_pvalue. -->
			<c7a_umbral_pvalue_alta>0.05</c7a_umbral_pvalue_alta>
			<!-- C7a — delta_total mínimo para severidad ALTA (artículos de unidad / de peso). -->
			<c7a_umbral_alta_delta_unidad>10.0</c7a_umbral_alta_delta_unidad>
			<c7a_umbral_alta_delta_peso>5.0</c7a_umbral_alta_delta_peso>
			<!-- C7a — Theil-Sen slope mínimo (ud./recepción o kg/recepción) para severidad ALTA. -->
			<c7a_umbral_alta_slope_unidad>2.0</c7a_umbral_alta_slope_unidad>
			<c7a_umbral_alta_slope_peso>1.0</c7a_umbral_alta_slope_peso>
			<!-- C7a — SNR mínimo (señal/ruido): cociente entre la pendiente Theil-Sen (ud/rec) y la
			     dispersión de los floors (std dev). Un artículo con slope=2.3 y dispersión=65.9
			     tiene SNR=0.035 — el ruido domina a la señal. Con n grande, Mann-Kendall siempre
			     detecta tendencia aunque el SNR sea ínfimo (sesgo de selección). Default 0.15 = la
			     pendiente debe ser al menos el 15% de la dispersión de los suelos. -->
			<c7a_umbral_snr>0.15</c7a_umbral_snr>
			<!-- C7a — Cascada exhaustiva: si true, continúa la cascada aunque un nivel dé negativo (diagnóstico).
			     Con n=3 floors, el nivel 1 (Mann-Kendall) siempre se omite por falta de potencia estadística
			     y la cascada empieza en el nivel 2 (bootstrap), independientemente de este parámetro. -->
			<c7a_cascada_exhaustiva>false</c7a_cascada_exhaustiva>
			<!-- C9 — Merma por backstaging LIFO inverso con ponderación exponencial.
			     Detecta merma intra-periodo a partir del sobrante/déficit de cada ciclo inter-recepción. -->
			<!-- C9 — Profundidad de backstaging: nº máximo de lotes anteriores que pueden absorber el déficit de un lote. Rango: 2–10 -->
			<c9_profundidad_k>5</c9_profundidad_k>
			<!-- C9 — Tasa de decaimiento exponencial del peso por distancia temporal (días). Rango: 0.05–1.0 -->
			<c9_beta>0.05</c9_beta>
			<!-- C9 — Multiplicador σ para el umbral de continuidad temporal (threshold_local = mu + lambda*sigma). Rango: 1.0–3.0 -->
			<c9_lambda>4</c9_lambda>
			<!-- C9 — Tolerancia de conservación de masa (kg/ud): |sum(S_t) - stock_final| ≤ epsilon → conservation_ok. Rango: 0.1–5.0 -->
			<c9_epsilon>5.0</c9_epsilon>
			<!-- C9 — Número mínimo de recepciones en el periodo para analizar el artículo. Rango: 2–10 -->
			<c9_min_recepciones>3</c9_min_recepciones>
			<!-- C9 — Merma mínima (ud.) para reportar el artículo. Filtra ruido en artículos por unidad. Rango: 0.5–10.0 -->
			<c9_umbral_merma_unidad>2.0</c9_umbral_merma_unidad>
			<!-- C9 — Merma mínima (kg) para reportar el artículo. Artículos de peso. Rango: 0.2–5.0 -->
			<c9_umbral_merma_peso>1.0</c9_umbral_merma_peso>
			<!-- C9 — Días a ampliar tras ff_mov para buscar la primera recepción post-periodo (cierre del último ciclo). Rango: 30–120 -->
			<c9_dias_post>60</c9_dias_post>
			<!-- Vista tabla: 1 = mostrar valores técnicos del modelo (β, n_lotes, conservación, parámetros C9…) en el detalle de cada incidencia. 0 = vista operario (solo información accionable). -->
		<posstock_mostrar_tecnico>0</posstock_mostrar_tecnico>
		<!-- Último rango consultado: preselecciona los selectores al abrir el informe -->
			<tipo_periodo></tipo_periodo>
			<numero_periodo></numero_periodo>
			<anio_periodo></anio_periodo>
		</posstock>
	</configuracion>
</parametros>
