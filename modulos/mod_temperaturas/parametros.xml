<parametros>
    <configuracion>
        <!-- Número de registros diarios requeridos -->
        <registros_diarios descripcion="Número de registros por día">2</registros_diarios>

        <!-- Configuración de cada registro -->
        <registro1 hora="08:00" forzar="Si" descripcion="Registro matutino"></registro1>
        <registro2 hora="20:00" forzar="Si" descripcion="Registro nocturno"></registro2>
        <registro3 hora="" forzar="No" descripcion="Registro extra (opcional)"></registro3>
        <registro4 hora="" forzar="No" descripcion="Registro extra (opcional)"></registro4>

        <!-- Alertas de temperatura -->
        <alerta_maxima valor="25" descripcion="Temperatura máxima alerta"></alerta_maxima>
        <alerta_minima valor="18" descripcion="Temperatura mínima alerta"></alerta_minima>

        <!-- Otras configuraciones -->
        <dias_historico valor="30" descripcion="Días de historial a mostrar por defecto"></dias_historico>
        <auto_guardar valor="Si" descripcion="Auto-guardar registros temporales"></auto_guardar>
    </configuracion>
</parametros>
