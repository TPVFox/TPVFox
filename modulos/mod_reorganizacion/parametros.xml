<?xml version="1.0" encoding="utf-8"?>
<parametros>
    <configuracion>
        <cierre_stock_anual>
            <ajustes_globales>
                <!-- Nombre e id del proveedor por defecto -->
                <proveedor id="112">Proveedor de cierre de stock anual</proveedor>
                <!-- Nº de productos por albarán -->
                <num_productos>100</num_productos>
                <!-- Indica si al hacer un segundo se reecriben albaranes anteriores o se crea uno nuevo -->
                <reescribir_albaran>true</reescribir_albaran>
                <!-- Serie del albarán de cierre / apertura -->
                <serie_albaran>
                    <cierre>C</cierre>
                    <apertura>A</apertura>
                </serie_albaran>
            </ajustes_globales>

            <familias_excluidas>
                <familia id="21">Servicios</familia>
                <familia id="22">Muestras</familia>
                <familia id="13">Cupones</familia>
                <familia id="42">Packaging</familia>
            </familias_excluidas>
        </cierre_stock_anual>
    </configuracion>
    <cajas_input data-obj="id_input">
        <caja_input>
            <nombre id_input="id_proveedor">cajaIdProveedor</nombre>
            <teclas>
                <action tecla="13">buscarProveedor</action>
                <action tecla="39">Saltar_Siguiente</action>
                <action tecla="38">Saltar_fecha</action>
                <action tecla=" 9">Saltar_Siguiente</action>
                <action tecla="40">Saltar_idArticulo</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>
        <caja_input>
            <nombre id_input="Proveedor">cajaProveedor</nombre>
            <teclas>
                <action tecla="13">buscarProveedor</action>
                <action tecla="37">Saltar_idProveedor</action>
                <action tecla="39">Saltar_idArticulo</action>
                <action tecla="38">Saltar_fecha</action>
                <action tecla=" 9">buscarProveedor</action>
                <action tecla="40">Saltar_idArticulo</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>
        <caja_input>
            <nombre id_input="cajaBusquedaproveedor">cajaBusquedaproveedor</nombre>
            <teclas>
                <action tecla="13">buscarProveedor</action>
                <action tecla="40">mover_down</action>
                <action tecla="9">mover_down</action>
                <action tecla="38">mover_up</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>

        <caja_input>
            <nombre id_input="id_familia">cajaIdFamilia</nombre>
            <teclas>
                <action tecla="13">buscarFamilia</action>
                <action tecla="39">Saltar_Siguiente</action>
                <action tecla="38">Saltar_fecha</action>
                <action tecla=" 9">Saltar_Siguiente</action>
                <action tecla="40">Saltar_idArticulo</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>
        <caja_input>
            <nombre id_input="Familia">cajaFamilia</nombre>
            <teclas>
                <action tecla="13">buscarFamilia</action>
                <action tecla="37">Saltar_idFamilia</action>
                <action tecla="39">Saltar_idArticulo</action>
                <action tecla="38">Saltar_fecha</action>
                <action tecla=" 9">buscarFamilia</action>
                <action tecla="40">Saltar_idArticulo</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>
        <caja_input>
            <nombre id_input="cajaBusquedafamilia">cajaBusquedafamilia</nombre>
            <teclas>
                <action tecla="13">buscarFamilia</action>
                <action tecla="40">mover_down</action>
                <action tecla="9">mover_down</action>
                <action tecla="38">mover_up</action>
            </teclas>
            <parametros>
                <parametro nombre="dedonde">reorganizarTPV</parametro>
            </parametros>
        </caja_input>
    </cajas_input>
</parametros>
